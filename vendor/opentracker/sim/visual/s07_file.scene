  fill 293 300 294 410 000000 2
region recent.sel
  fill 304 65 304 92 FFFFFF 4
  row 65 310 590 FFFFFF 30
  row 92 310 590 FFFFFF 30
  fill 310 70 590 88 0A0A0A 1

region bar.strip
