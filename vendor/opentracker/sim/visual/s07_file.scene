# Snapshot_007: File -> Open Project (VISUAL_DIFF §3.6). SD browser focused at
# /Projects ("/.." cursor, red row frame), Recent empty with a white frame row.
# The stock project is open (title: its name) and copied into /Projects, but
# the stock card's other projects differ from the fixture's (B1t Crunch3r,
# Blind Method, Das Mortal, Defrag are not on it), so the list length and the
# scrollbar thumb are @content.
stock Snapshot_007.png
project Jude Frankum - Chill Out Room
script
  wait 300
  tap DOWN x13
  tap FILE
  tap F2
  wait 300
end

region title.bg
  fill 205 0 295 25 080808 2
region title.sep
  row 27 0 799 1D1D1D 3
  row 28 0 799 8F8F8F 3
region title.text @font
  bbox 9 8 196 22 1
region transport.time @font
  bbox 300 8 358 19 1
region transport.icon
  fill 376 9 378 18 FFFFFF 8
  fill 381 9 383 18 FFFFFF 8
region project.name @font
  bbox ~530 8 789 19 2

region panel.focus
  row 31 1 298 CD1818 3
  fill 1 40 1 400 CD1818 3
  fill 298 40 298 400 CD1818 3
  row 422 10 290 CD1818 3
region panel.fill
  fill 310 100 590 400 0A0A0A 1
  fill 610 40 790 400 0A0A0A 1
region panel.gaps
  fill 599 100 600 400 050505 2
region panel.shadow
  pix 450 414 090909 1
  pix 450 417 070707 1
  pix 450 421 030303 1
region caption @font
  bbox 116 40 184 51 1
  bbox 421 40 478 51 1
