# Snapshot_033: Config > General > Pads preview picker (VISUAL_DIFF §8.19,
# Part 2 §11). Help panel + picker list inside one red focus frame, strip
# 050505 with separators only at 200 / 600 / 700. The help text is our own
# (config_help.cpp), so only its left / top edges are checked.
stock Snapshot_033.png
project Jude Frankum - Chill Out Room
script
  wait 300
  tap CONFIG
  tap F2               # category General
  tap F6 x9
  tap F8               # Enter -> picker
end
region category.list
  fill 1 107 198 120 0A0A0A 1
  row 60 4 195 FFFFFF 4
  row 87 4 195 FFFFFF 4
region category.text @font
  bbox 14 41 140 54 1
  bbox 14 68 68 78 1
region picker.focus
  row 31 201 598 CD1818 4
  row 422 201 598 CD1818 4
  fill 201 32 201 421 CD1818 4
  fill 598 32 598 421 CD1818 4
region help.panel
  fill 204 300 399 400 0A0A0A 1
  fill 400 40 400 400 080808 2
  fill 401 300 595 400 0A0A0A 1
region help.caption @font
  bbox 215 40 353 53 1
region help.text @font @content
  bbox 215 69 376 80 1
region picker.sel
  row 60 404 595 FFFFFF 4
  fill 404 34 404 60 FFFFFF 4
  fill 595 34 595 60 FFFFFF 4
region picker.text @font
  bbox 414 41 547 51 1
region bar.strip.dark
  row 430 1 798 050505 2
  fill 200 438 200 479 434343 3
  fill 600 438 600 479 434343 3
  fill 700 438 700 479 434343 3
  fill 100 462 100 479 050505 2
  fill 400 462 400 479 050505 2
region bar.wide @font
  bbox 13 451 26 456 1
  bbox 173 451 186 456 1
  bbox 75 446 125 456 1
  bbox 243 451 256 456 1
  bbox 543 451 556 456 1
  bbox 332 446 469 459 1
region bar.labels @font
  bbox 630 446 672 456 1
  bbox 732 446 769 459 1
