  row 60 206 289 7E7E7E 6
  fill 205 33 205 60 7E7E7E 6
  fill 210 92 245 106 3E3E3E 20
  fill 210 360 245 400 3E3E3E 20
region delay.rate.scroll
  fill 293 37 296 416 7E7E7E 60
  fill 292 60 292 400 5B5B5B 12
  fill 297 60 297 400 5B5B5B 12
region delay.bars @content
  fill 313 300 388 400 C9C9CA 2
  fill 413 310 488 400 C9C9CA 2
  fill 513 39 588 408 C9C9CA 2
region delay.linein.disabled
  row 408 613 688 303030 6
  fill 613 40 688 405 3E3E3E 1
region delay.back.panel
  fill 702 40 798 400 3E3E3E 1
region bar.labels @font
  bbox 20 436 80 449 1
  bbox 137 436 165 449 1
  bbox 335 436 366 446 1
  bbox 419 436 480 446 1
  bbox 529 436 571 446 1
region bar.rate.disabled
