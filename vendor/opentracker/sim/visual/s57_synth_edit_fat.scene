# s57_synth_edit_fat.scene — 2.1 FAT engine: Synth 2 switched to FAT on
# its Parameters page (F1 Model, F1 again = the next model, Init patch),
# then Edit Patch, Osc section, Fatness selected. Layout as s54 (ACD Filter
# section). No stock reference: self-consistency checks.
stock none
project Jude Frankum - Chill Out Room
script
  wait 300
  press INSTR
  wait 400
  enc -70              # Synth 1 (first entry)
  enc 1                # Synth 2 (instrument 65)
  release INSTR
  wait 100
  tap INSTRPARAMS
  wait 100
  tap F2               # Polyphony selected
  tap F1               # Model selected
  tap F1               # pressed again: next model, ACD -> FAT (Init patch)
  wait 300
  tap F8               # Edit Patch (Osc section)
  wait 2500            # the "Init patch loaded" notice has gone
end
# Header: "Edit Patch: Init" left, "Synth 2 (FAT)" right (an available
# model: no "not available").
region title.text @font
  bbox 9 7 166 19 1
  bbox ~600 7 785 23 1
# Section grid (manual p.153): the selected section (Osc, column 0) has the
# red 1.5-px frame on its inner edge lines (x 10 / 98, y 41 / 94).
region synth.sections.focus
  fill 10 43 10 92 CD1818 4
  fill 98 43 98 92 CD1818 4
  row 41 12 96 CD1818 4
  row 94 12 96 CD1818 4
  fill 107 41 107 95 0A0A0A 2       # Filter: no frame
region synth.sections.text @font
  bbox 44 62 65 73 1
  bbox 132 62 173 73 1
  bbox 47 255 61 265 1
# Parameter list above F5..F7: the white row frame on row 0 (Fatness),
# value "10" (Fatness 0.1, shown x 100); row 1 Brightness "100".
region synth.params.selection
  row 33 406 693 FFFFFF 8
  row 60 406 693 FFFFFF 8
  fill 404 37 404 56 FFFFFF 8
  fill 695 37 695 56 FFFFFF 8
  row 87 406 693 0A0A0A 2           # row 1 not framed
region synth.params.text @font
  bbox 416 41 469 51 1
  bbox 672 40 685 51 1
  bbox 416 67 493 81 1
  bbox 664 68 685 78 1
# The selected value above F8: Fatness 0.1 of 0..1 fills the bottom tenth
# of the bar track (rows 372..408).
region synth.value.bar
  fill 712 375 787 406 FFFFFF 2
  fill 725 45 787 368 080808 2
# Bottom bar: F1 Save, F2 Save As, F3 Init / Patch, F6 the section name
# (Oscillator), F8 Back.
region bar.labels @font
  bbox 37 446 65 456 1
  bbox 225 436 272 468 1
  bbox 516 445 587 456 1
  bbox 737 445 764 456 1
