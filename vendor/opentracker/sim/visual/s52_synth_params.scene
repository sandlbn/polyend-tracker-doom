# s52_synth_params.scene — 2.x WP-G (docs/MINI_PLAN.md §3 UI; Tracker Mini
# manual p.147): Synth Parameters 1/2 of Synth 2 (ACD, Init). No stock
# reference: self-consistency checks against the stock Instrument Parameters
# chrome (s11): model list above F1, value bars above F2..F6, the patch panel
# above F7 / F8, the red focus frame on the selected column.
stock none
project Jude Frankum - Chill Out Room
script
  wait 300
  press INSTR
  wait 400
  enc -70              # Instruments popup: clamps at Synth 1 (the first entry)
  enc 1                # Synth 2 (instrument 65)
  release INSTR
  wait 100
  tap INSTRPARAMS
  wait 200
end
# Title (s11 chrome): bold title at x 9, the slot / model right-aligned at 790.
region title.text @font
  bbox 9 7 208 23 1
  bbox ~600 7 785 23 1
# F1 Model selected: red focus frame on the column centre lines x 1 / 98
# (s11 panelFocus geometry).
region synth.focus.model
  fill 1 31 1 422 CD1818 4
  fill 98 31 98 422 CD1818 4
  fill 150 31 150 38 0A0A0A 2         # no frame on the Polyphony column
# Model list: white row frame around "ACD" (list row 0, s11 Filter list).
region synth.model.list
  row 60 8 91 FFFFFF 8
  fill 4 38 4 56 FFFFFF 8
  fill 95 38 95 56 FFFFFF 8
  fill 8 64 91 66 0A0A0A 2            # row 1 not framed
region synth.model.text @font
  bbox 15 40 38 51 1
  bbox 16 68 38 78 1
# Value bars (s11 bar geometry, fill x 112 + 100 k .. 187 + 100 k): Polyphony
# 0 = the 1.5-px base line, Gain 0 dB = (0 + 96) / 108 of the track, Panning
# 0 = the bipolar centre line.
region synth.bars @content
  row 407 112 187 FFFFFF 2
  row 408 112 187 FFFFFF 2
  fill 125 60 187 404 080808 2       # right of the 9-px inner gradient
  fill 212 80 287 408 FFFFFF 2
  fill 225 45 287 77 080808 2
  row 224 312 387 FFFFFF 2
  fill 325 215 387 222 080808 2
  fill 325 226 387 240 080808 2
# Patch panel above F7 / F8: "Patch:" and the name below it.
region synth.patch.panel
  fill 605 90 796 400 0A0A0A 1
region synth.patch.text @font
  bbox 615 41 656 52 1
# Bottom labels: two-line Model / ACD, Load / Patch, Edit / Patch.
region bar.labels @font
  bbox 33 435 70 468 1
  bbox 625 435 672 468 1
  bbox 725 435 772 468 1
