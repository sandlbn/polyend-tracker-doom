# Snapshot_009 (round 3): Track Mixer 2/3.
# Round-3 stock shot (owner's unit, firmware 1.9.2, Display theme
# Monochrome, project "OT Test 01 - Twelve Tracks"; 2.x tools/make_testsongs).
# The scene boots the fixture project "Jude Frankum - Chill Out Room", so
# checks on project values / names are @content. Theme 1 = Monochrome.
stock round3/Snapshot_009.png
project Jude Frankum - Chill Out Room
script
  wait 300
  theme 1              # Monochrome (the round-3 shots)
  tap MASTER x2
end
region title.bg
  fill 200 0 290 25 B9B9BA 2
  fill 480 0 799 25 B9B9BA 2
region title.sep
  row 28 0 799 C2C2C3 4
region title.text @font
  bbox 9 8 157 20 1
region mixer.headers
  fill 2 32 98 38 B9B9BA 2
  fill 2 55 98 58 B9B9BA 2
  fill 702 32 798 38 B9B9BA 2
  row 31 2 98 7E7E7E 6
  row 59 2 98 7E7E7E 6
  fill 0 60 799 62 4B4B4B 1
region mixer.header.text @font @content
  bbox 31 40 70 51 1
  bbox 542 40 559 54 1
region mixer.panels
  fill 2 64 49 73 3E3E3E 1
  fill 52 64 99 73 3E3E3E 1
region mixer.fader @content
  fill 13 130 38 400 C9C9CA 2
  fill 20 76 39 115 3E3E3E 1
region mixer.meter
  row 408 63 88 30CB3F 4
  fill 70 76 89 404 3E3E3E 1
region bar.labels @font @content
  bbox 23 436 78 446 1
  bbox 31 456 69 467 1
  bbox 731 456 769 467 1
