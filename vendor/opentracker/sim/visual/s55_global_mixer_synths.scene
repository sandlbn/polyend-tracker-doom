# s55_global_mixer_synths.scene — 2.x WP-G (manual p.220): Global Mixer 3/3
# with the Synth 1-3 columns above F5..F7 (level = slot gain, no mute). No
# stock reference: self-consistency checks against the s23 / s24 geometry.
stock none
project Jude Frankum - Chill Out Room
script
  wait 300
  tap MASTER x3
  wait 200
end
# Synth 1..3 column headers at x 402 / 502 / 602 (s24 header geometry:
# bold names centred on 50 + 100 k, band rows 32..58).
region mixer.synth.headers @font
  bbox 415 39 481 55 1
  bbox 515 39 584 55 1
  bbox 615 39 683 55 1
# Each synth column = the s23 Track Mixer pair: a 47-px level fader (fill x
# 413..438) and a 47-px meter (x 452..497, green base line 463..488 at rest).
# The level is the slot gain on (dB + 96) / 108 of the track: the stock
# fixture's slots read 0 dB (fill rows 111..408).
region mixer.synth.faders @content
  fill 413 111 438 408 FFFFFF 2
  fill 513 111 538 408 FFFFFF 2
  fill 613 111 638 408 FFFFFF 2
  fill 425 80 438 108 080808 2
region mixer.synth.meters
  row 408 463 488 30CB3F 4
  row 408 563 588 30CB3F 4
  row 408 663 688 30CB3F 4
  fill 475 120 488 400 080808 2
# The rest (F8) one empty panel (s24 rightpanel rule).
region mixer.synth.rightpanel
  fill 705 40 796 400 0A0A0A 1
  fill 700 70 700 400 040404 2       # column gap
# Bottom labels F5..F7: the gain only, one grey line (no Mute: manual p.220).
region bar.synth.labels @font @content
  bbox 424 445 478 456 1
  bbox 624 445 678 456 1
  fill 410 460 490 475 0A0A0A 2
