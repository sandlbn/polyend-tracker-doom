# s51_song_window.scene — 2.x M1 (docs/M1_PLAN.md §4, spec gap 4): Song grid
# with its 12-column window shifted to tracks 5..16 (grid cursor on track
# 13). No stock reference: self-consistency checks against the s10 geometry.
stock none
project Jude Frankum - Chill Out Room
script
  wait 300
  tap DOWN x13
  tap SONG
  wait 300
  tap REC
  tap LEFT             # list -> grid, rightmost column (track 12)
  tap RIGHT            # track 13: window shifts to tracks 5..16
  wait 100
end

# Column c shows track 5 + c: headers at the s10 columns (x 20 + 40 c), the
# rotated "Track 5".."Track 8" / "Midi 9".."Midi 16" ink ending at y 86
# (x edges not checked: the glyph widths differ per word).
region grid.labels @font
  bbox ~20 ~38 ~29 86 2
  bbox ~60 ~38 ~69 86 2
  bbox ~100 ~38 ~109 86 2
  bbox ~140 ~38 ~149 86 2
  bbox ~180 ~38 ~189 86 2
  bbox ~220 ~38 ~229 86 2
  bbox ~260 ~38 ~269 86 2
  bbox ~300 ~38 ~309 86 2
  bbox ~340 ~38 ~349 85 1       # tol 1: the selection outline starts at y 90
  bbox ~380 ~38 ~389 86 2
  bbox ~420 ~38 ~429 86 2
  bbox ~460 ~38 ~469 86 2
# Tracks 5..12 (columns 0..7) show the same slot usage as stock columns
