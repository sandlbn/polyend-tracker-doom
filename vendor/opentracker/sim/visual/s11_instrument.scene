# Snapshot_011: Instrument Parameters 1/2 (VISUAL_DIFF §3.10). Volume column
# focused, white 76-px bars in 80-px wells, bipolar centre lines, Filter Type
# list. Stock instrument "Bass02" (stock project) uses High-pass / cutoff 35.
stock Snapshot_011.png
project Jude Frankum - Chill Out Room
script
  wait 300
  tap DOWN x13
  tap INSTRPARAMS
  wait 300
end

region title.sep
  row 27 0 799 1D1D1D 3
  row 28 0 799 8F8F8F 3
region title.text @font
  bbox 9 8 257 20 1
region transport.time @font
  bbox 300 8 358 19 1
region transport.icon
  fill 376 9 378 18 FFFFFF 8
  fill 381 9 383 18 FFFFFF 8
region instr.name @font
