# s19_fill_popup.scene — Snapshot_019 (W3) (docs/VISUAL_DIFF_1.9.4.md Part 2 §11).
# Tags: @font = depends on font metrics, @content = the stock card shows
# another project (B1t Crunch3r - Dimension X from Snapshot_015 on).
stock Snapshot_019.png
project Jude Frankum - Chill Out Room
script
  wait 300
  tap REC              # Fill opens in edit mode only
  tap FX1              # cursor column Fx 1 (Right moves the track, spec 06 §1.5)
  tap F4
  tap F1 x5            # Where? = Each (the stock card's choice)
  tap F2               # Step field ...
  pad 0                # ... = 1 (pad 0)
  tap F1               # focus back on Where?
end
region fill.header
  fill 100 30 799 35 080808 2
  fill 100 48 799 55 080808 2
region fill.header.text @font
  bbox 10 36 95 47 1
region fill.focus
  row 58 1 98 CD1818 4
  row 422 1 98 CD1818 4
  fill 1 59 1 421 CD1818 4
  fill 98 59 98 421 CD1818 4
region fill.col1.sel
  row 197 4 95 FFFFFF 4
  row 224 4 95 FFFFFF 4
region fill.col1.text @font
  bbox 14 70 ~60 80 1
region fill.col2.bar
  fill 119 69 188 405 080808 1
  row 407 112 187 FFFFFF 4
  pix 111 200 000000 1
region fill.col3.sel
  row 89 204 288 FFFFFF 4
  row 116 204 288 FFFFFF 4
region fill.col3.scroll
